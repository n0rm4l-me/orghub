generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  avatarUrl      String?
  /// bcrypt hash. Null for accounts that sign in only through an identity provider.
  passwordHash   String?
  role           Role      @default(VIEWER)
  department     String?
  externalId     String?
  provider       String?   @default("local")
  active         Boolean   @default(true)
  organizationId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lastFeedVisitAt DateTime?

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  accounts      Account[]
  sessions      Session[]
  articles      Article[]
  auditLogs     AuditLog[]
  reactions     ArticleReaction[]
  comments      Comment[]
  views         ArticleView[]
  pollsAuthored Poll[]      @relation("PollAuthor")
  pollVotes     PollVote[]  @relation("PollVoter")
  kudosSent     Kudos[]     @relation("KudosSender")
  kudosReceived Kudos[]     @relation("KudosRecipient")
  kudosRedemptions KudosRedemption[]
  notifications    Notification[]
  pushSubscriptions PushSubscription[]
  media            Media[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Article {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  body           Json
  excerpt        String?
  coverImage     String?
  published      Boolean   @default(false)
  publishedAt    DateTime?
  organizationId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  eventDate     DateTime?
  eventEndDate  DateTime?
  eventLocation String?
  pinned           Boolean   @default(false)
  important        Boolean   @default(false)
  commentsEnabled  Boolean   @default(true)

  authorId   String
  author     User                   @relation(fields: [authorId], references: [id])
  categories CategoriesOnArticles[]
  reactions  ArticleReaction[]
  comments   Comment[]
  views      ArticleView[]
  translations ArticleTranslation[]

  @@index([published, publishedAt])
  @@index([published, eventDate])
  @@index([organizationId])
}

model ArticleView {
  articleId String
  userId    String
  viewedAt  DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([articleId, userId])
  @@index([articleId])
  @@index([viewedAt])
}

model Page {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  body           Json
  published      Boolean  @default(false)
  /// Published pages are linked from the main menu unless this is turned off.
  showInNav      Boolean  @default(true)
  order          Int      @default(0)
  organizationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parentId String?
  parent   Page?   @relation("PageChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children Page[]  @relation("PageChildren")

  @@index([published, order])
  @@index([parentId])
}

/// Sidebar shortcuts on the feed: payroll, VPN, service desk, and the like.
model QuickLink {
  id        String   @id @default(cuid())
  label     String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([order])
}

model Category {
  id       String                 @id @default(cuid())
  name     String
  slug     String                 @unique
  articles CategoriesOnArticles[]
}

model CategoriesOnArticles {
  articleId  String
  categoryId String
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([articleId, categoryId])
}

model Media {
  id           String   @id @default(cuid())
  filename     String
  key          String   @unique
  url          String
  mimeType     String
  size         Int
  context      String?
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([uploadedById])
  @@index([createdAt])
  @@index([context])
}

model SiteSettings {
  id       String  @id @default("singleton")
  siteName String  @default("OrgHub")
  /// Logo for the brand-coloured header and the admin rail. Usually a white or
  /// knocked-out asset, which is why it must not be reused on white surfaces.
  logoUrl  String?
  /// Logo for white surfaces: the sign-in screen. Optional; when it is absent the
  /// lettermark is used, because falling back to `logoUrl` tends to render a white
  /// logo on a white card.
  logoOnLightUrl String?
  primaryColor   String @default("#2563eb")
  /// Comma-separated IDs of the feed sidebar blocks in display order.
  sidebarOrder   String @default("quickLinks,browseByTopic,upcomingEvents")
  /// Comma-separated IDs of enabled optional modules (e.g. "events").
  enabledModules String @default("events")
  /// Layout for the feed homepage: "content" | "sidebar-right" | "sidebar-left" | "sidebar-both"
  feedLayout     String @default("sidebar-right")
  /// Layout for article reader pages.
  articleLayout  String @default("sidebar-right")
  /// Layout for static wiki Pages.
  pagesLayout    String @default("content")
  /// Layout for the Kudos wall page.
  kudosLayout    String @default("content")
  /// Layout for the Events calendar page.
  eventsLayout   String @default("content")
  /// Comma-separated IDs of widgets in the left sidebar, in display order.
  leftSidebarOrder String @default("")
  /// Portal content width: "narrow" (1024px) | "default" (1152px) | "wide" (1280px)
  portalWidth      String @default("default")
  /// Number of articles per page on the feed.
  feedPageSize     Int    @default(15)
  /// Feed card style: "compact" | "default" | "preview"
  feedCardStyle    String @default("preview")
  /// When false, the email/password login form is hidden and the local Credentials provider rejects all attempts.
  localAuthEnabled Boolean @default(true)
  /// When false, Gravatar requests are skipped and only initials are shown.
  gravatarsEnabled Boolean @default(true)
  /// Comma-separated IDs of module nav items shown in the header, in display order.
  navOrder         String  @default("events,polls")
  /// Kudos: monthly coin budget per user (0 = unlimited).
  kudosMonthlyBudget  Int     @default(100)
  /// Kudos: comma-separated list of company values users can tag.
  kudosValues         String  @default("Innovation,Teamwork,Quality,Customer Focus")
  /// Kudos: enable the Redeem button on the user balance page.
  kudosRedeemEnabled  Boolean @default(false)
  /// Kudos: webhook URL called when a user redeems coins (POST with JSON body).
  kudosRedeemWebhook  String?
  /// Kudos: human-readable exchange rate label shown on the Redeem button.
  kudosRedeemRateLabel String?
  /// Translation: provider to use — "mymemory" | "deepl" | "hf"
  translationProvider  String  @default("mymemory")
  /// Translation: comma-separated target language codes enabled for users.
  translationLanguages String  @default("en,ru,ja,zh,es,fr,hi,uk")
  /// Layout for the Dining portal page.
  diningLayout String @default("content")
  /// ISO 4217 currency code used for dining prices (e.g. "JPY", "USD", "EUR").
  diningCurrency String @default("JPY")
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  authorId  String
  author    User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model ArticleReaction {
  articleId String
  userId    String
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([articleId, userId])
  @@index([articleId])
}

model Announcement {
  id         String    @id @default(cuid())
  message    String
  linkUrl    String?
  linkLabel  String?
  color      String    @default("brand")
  active     Boolean   @default(false)
  showFrom   DateTime?
  showUntil  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([active])
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  action       String
  resourceType String?
  resourceId   String?
  metadata     Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

enum PollStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum ResultsVisibility {
  ALWAYS
  AFTER_VOTE
  AFTER_CLOSE
  NEVER
}

model Poll {
  id                String            @id @default(cuid())
  question          String
  status            PollStatus        @default(DRAFT)
  anonymous         Boolean           @default(false)
  multiChoice       Boolean           @default(false)
  resultsVisibility ResultsVisibility @default(AFTER_VOTE)
  endsAt            DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  authorId          String
  author            User              @relation("PollAuthor", fields: [authorId], references: [id])
  options           PollOption[]
  votes             PollVote[]

  @@index([status, createdAt])
}

model PollOption {
  id     String     @id @default(cuid())
  pollId String
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text   String
  order  Int
  votes  PollVote[]
}

model PollVote {
  id        String     @id @default(cuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation("PollVoter", fields: [userId], references: [id])
  createdAt DateTime   @default(now())

  @@unique([pollId, userId, optionId])
  @@index([pollId])
}

model Kudos {
  id          String   @id @default(cuid())
  fromId      String
  toId        String
  amount      Int      @default(1)
  message     String
  value       String?
  createdAt   DateTime @default(now())

  from        User     @relation("KudosSender",    fields: [fromId], references: [id], onDelete: Cascade)
  to          User     @relation("KudosRecipient", fields: [toId],   references: [id], onDelete: Cascade)

  @@index([toId, createdAt])
  @@index([fromId, createdAt])
  @@index([createdAt])
}

enum RedemptionStatus {
  PENDING
  DONE
  FAILED
  REJECTED
}

model KudosRedeemType {
  id          String            @id @default(cuid())
  label       String
  rateLabel   String?
  webhook     String?
  active      Boolean           @default(true)
  order       Int               @default(0)
  redemptions KudosRedemption[]

  @@index([active, order])
}

model KudosRedemption {
  id              String           @id @default(cuid())
  userId          String
  amount          Int
  status          RedemptionStatus @default(PENDING)
  webhookResponse String?
  createdAt       DateTime         @default(now())
  typeId          String?

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  redeemType      KudosRedeemType?  @relation(fields: [typeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model ArticleTranslation {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  lang      String
  title     String
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@unique([articleId, lang])
  @@index([articleId])
}

// ── Dining module ─────────────────────────────────────────────────────────────

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
}

model Location {
  id        String   @id @default(cuid())
  name      String
  timezone  String   @default("America/New_York")
  createdAt DateTime @default(now())
  venues    Venue[]
  users     User[]
}

model Venue {
  id                String   @id @default(cuid())
  locationId        String
  location          Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name              String
  /// CAFETERIA | CAFE | RESTAURANT — affects defaults and portal layout
  venueType         String   @default("CAFETERIA")
  weeklyMenuEnabled Boolean  @default(true)
  topicsEnabled     Boolean  @default(true)
  orderingEnabled   Boolean  @default(false)
  workingDays       String   @default("MON,TUE,WED,THU,FRI")
  createdAt         DateTime @default(now())
  categories        MealCategory[]
  dishes            Dish[]
  weekMenus         WeekMenu[]
  topics            MonthlyTopic[]
  mealSlots         MealSlot[]
  venueTags         VenueTag[]
  nutritionParams   NutritionParam[]
}

model MealSlot {
  id         String         @id @default(cuid())
  venueId    String
  venue      Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name       String
  timeStart  String?
  timeEnd    String?
  order      Int
  categories MealCategory[]
  entries    WeekMenuEntry[]

  @@index([venueId, order])
}

model VenueTag {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name    String
  color   String @default("#374151")
  bgColor String @default("#F3F4F6")
  order   Int

  @@index([venueId])
}

model NutritionParam {
  id       String  @id @default(cuid())
  venueId  String
  venue    Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name     String
  unit     String  @default("")
  featured Boolean @default(false)
  order    Int

  @@index([venueId])
}

model MealCategory {
  id         String    @id @default(cuid())
  venueId    String
  venue      Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  mealSlotId String
  mealSlot   MealSlot  @relation(fields: [mealSlotId], references: [id], onDelete: Cascade)
  name       String
  order      Int
  entries    WeekMenuEntry[]

  @@index([venueId, order])
}

model Dish {
  id             String   @id @default(cuid())
  venueId        String
  venue          Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  photo          String?
  price          Decimal? @db.Decimal(10, 2)
  nutrition      Json?
  tagIds         String   @default("")
  createdAt      DateTime @default(now())
  entries        WeekMenuEntry[]
  fixedEntries   FixedMenuEntry[]
  modifierGroups DishModifierGroup[]

  @@index([venueId])
}

model DishModifierGroup {
  id          String   @id @default(cuid())
  dishId      String
  dish        Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  name        String
  required    Boolean  @default(false)
  multiSelect Boolean  @default(false)
  order       Int
  options     DishModifierOption[]

  @@index([dishId, order])
}

model DishModifierOption {
  id         String   @id @default(cuid())
  groupId    String
  group      DishModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  label      String
  priceDelta Decimal  @default(0) @db.Decimal(10, 2)
  isDefault  Boolean  @default(false)
  order      Int

  @@index([groupId, order])
}

model WeekMenu {
  id          String    @id @default(cuid())
  venueId     String
  venue       Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name        String?
  menuType    String    @default("WEEKLY")
  weekStart   DateTime
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  /// Comma-separated DayOfWeek values for days when the venue is closed this week
  closedDays  String    @default("")
  entries     WeekMenuEntry[]
  fixedSections FixedMenuSection[]

  @@index([venueId, createdAt])
}

model FixedMenuSection {
  id         String          @id @default(cuid())
  weekMenuId String
  weekMenu   WeekMenu        @relation(fields: [weekMenuId], references: [id], onDelete: Cascade)
  name       String
  order      Int
  entries    FixedMenuEntry[]

  @@index([weekMenuId, order])
}

model FixedMenuEntry {
  id          String   @id @default(cuid())
  sectionId   String
  section     FixedMenuSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  dishId      String?
  dish        Dish?    @relation(fields: [dishId], references: [id], onDelete: SetNull)
  name        String?
  description String?
  photo       String?
  price       Decimal? @db.Decimal(10, 2)
  nutrition   Json?
  tagIds      String   @default("")
  note        String?
  soldOut     Boolean  @default(false)
  order       Int
  modifierGroups FixedMenuModifierGroup[]

  @@index([sectionId, order])
}

model FixedMenuModifierGroup {
  id          String   @id @default(cuid())
  entryId     String
  entry       FixedMenuEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  name        String
  required    Boolean  @default(false)
  multiSelect Boolean  @default(false)
  order       Int
  options     FixedMenuModifierOption[]

  @@index([entryId, order])
}

model FixedMenuModifierOption {
  id         String   @id @default(cuid())
  groupId    String
  group      FixedMenuModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  label      String
  priceDelta Decimal  @default(0) @db.Decimal(10, 2)
  isDefault  Boolean  @default(false)
  color      String?
  order      Int

  @@index([groupId, order])
}

model WeekMenuEntry {
  id          String       @id @default(cuid())
  weekMenuId  String
  weekMenu    WeekMenu     @relation(fields: [weekMenuId], references: [id], onDelete: Cascade)
  day         DayOfWeek
  mealSlotId  String
  mealSlot    MealSlot     @relation(fields: [mealSlotId], references: [id], onDelete: Cascade)
  categoryId  String
  category    MealCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  dishId      String?
  dish        Dish?        @relation(fields: [dishId], references: [id], onDelete: SetNull)
  name        String?
  description String?
  photo       String?
  nutrition   Json?
  tagIds      String       @default("")
  note        String?

  @@unique([weekMenuId, day, mealSlotId, categoryId])
  @@index([weekMenuId, day, mealSlotId])
}

model MonthlyTopic {
  id          String   @id @default(cuid())
  venueId     String
  venue       Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  title       String
  bannerImage String?
  body        String?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  highlights  MonthlyTopicHighlight[]

  // The portal looks up the newest published topic for one venue on every
  // dining page view; without this it is a sequential scan of the whole table.
  @@index([venueId, publishedAt])
}

model MonthlyTopicHighlight {
  id         String       @id @default(cuid())
  topicId    String
  topic      MonthlyTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  weekLabel  String
  image      String?
  name       String?
  description String?
  order      Int

  @@index([topicId, order])
}
