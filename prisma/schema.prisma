generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  avatarUrl      String?
  role           Role      @default(VIEWER)
  department     String?
  externalId     String?
  provider       String?   @default("local")
  active         Boolean   @default(true)
  organizationId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  articles  Article[]
  auditLogs AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Article {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  body           Json
  excerpt        String?
  coverImage     String?
  published      Boolean   @default(false)
  publishedAt    DateTime?
  organizationId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  authorId   String
  author     User                   @relation(fields: [authorId], references: [id])
  categories CategoriesOnArticles[]

  @@index([published, publishedAt])
  @@index([organizationId])
}

model Page {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  body           Json
  published      Boolean  @default(false)
  order          Int      @default(0)
  organizationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Category {
  id       String                 @id @default(cuid())
  name     String
  slug     String                 @unique
  articles CategoriesOnArticles[]
}

model CategoriesOnArticles {
  articleId  String
  categoryId String
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([articleId, categoryId])
}

model Media {
  id           String   @id @default(cuid())
  filename     String
  url          String
  mimeType     String
  size         Int
  uploadedById String
  createdAt    DateTime @default(now())
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  action       String
  resourceType String?
  resourceId   String?
  metadata     Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
