generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  avatarUrl      String?
  /// bcrypt hash. Null for accounts that sign in only through an identity provider.
  passwordHash   String?
  role           Role      @default(VIEWER)
  department     String?
  externalId     String?
  provider       String?   @default("local")
  active         Boolean   @default(true)
  organizationId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lastFeedVisitAt DateTime?

  accounts      Account[]
  sessions      Session[]
  articles      Article[]
  auditLogs     AuditLog[]
  reactions     ArticleReaction[]
  comments      Comment[]
  views         ArticleView[]
  pollsAuthored Poll[]      @relation("PollAuthor")
  pollVotes     PollVote[]  @relation("PollVoter")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Article {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  body           Json
  excerpt        String?
  coverImage     String?
  published      Boolean   @default(false)
  publishedAt    DateTime?
  organizationId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  eventDate     DateTime?
  eventEndDate  DateTime?
  eventLocation String?
  pinned           Boolean   @default(false)
  important        Boolean   @default(false)
  commentsEnabled  Boolean   @default(true)

  authorId   String
  author     User                   @relation(fields: [authorId], references: [id])
  categories CategoriesOnArticles[]
  reactions  ArticleReaction[]
  comments   Comment[]
  views      ArticleView[]

  @@index([published, publishedAt])
  @@index([published, eventDate])
  @@index([organizationId])
}

model ArticleView {
  articleId String
  userId    String
  viewedAt  DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([articleId, userId])
  @@index([articleId])
  @@index([viewedAt])
}

model Page {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  body           Json
  published      Boolean  @default(false)
  /// Published pages are linked from the main menu unless this is turned off.
  showInNav      Boolean  @default(true)
  order          Int      @default(0)
  organizationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parentId String?
  parent   Page?   @relation("PageChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children Page[]  @relation("PageChildren")

  @@index([published, order])
  @@index([parentId])
}

/// Sidebar shortcuts on the feed: payroll, VPN, service desk, and the like.
model QuickLink {
  id        String   @id @default(cuid())
  label     String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([order])
}

model Category {
  id       String                 @id @default(cuid())
  name     String
  slug     String                 @unique
  articles CategoriesOnArticles[]
}

model CategoriesOnArticles {
  articleId  String
  categoryId String
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([articleId, categoryId])
}

model Media {
  id           String   @id @default(cuid())
  filename     String
  url          String
  mimeType     String
  size         Int
  uploadedById String
  createdAt    DateTime @default(now())
}

model SiteSettings {
  id       String  @id @default("singleton")
  siteName String  @default("OrgHub")
  /// Logo for the brand-coloured header and the admin rail. Usually a white or
  /// knocked-out asset, which is why it must not be reused on white surfaces.
  logoUrl  String?
  /// Logo for white surfaces: the sign-in screen. Optional; when it is absent the
  /// lettermark is used, because falling back to `logoUrl` tends to render a white
  /// logo on a white card.
  logoOnLightUrl String?
  primaryColor   String @default("#2563eb")
  /// Comma-separated IDs of the feed sidebar blocks in display order.
  sidebarOrder   String @default("quickLinks,browseByTopic,upcomingEvents")
  /// Comma-separated IDs of enabled optional modules (e.g. "events").
  enabledModules String @default("events")
  /// Layout for the feed homepage: "content" | "sidebar-right" | "sidebar-left" | "sidebar-both"
  feedLayout     String @default("sidebar-right")
  /// Layout for article reader pages.
  articleLayout  String @default("sidebar-right")
  /// Layout for static wiki Pages.
  pagesLayout    String @default("content")
  /// Comma-separated IDs of widgets in the left sidebar, in display order.
  leftSidebarOrder String @default("")
  /// Portal content width: "narrow" (1024px) | "default" (1152px) | "wide" (1280px)
  portalWidth      String @default("default")
  /// Number of articles per page on the feed.
  feedPageSize     Int    @default(15)
  /// Feed card style: "compact" | "default" | "preview"
  feedCardStyle    String @default("preview")
  /// When false, the email/password login form is hidden and the local Credentials provider rejects all attempts.
  localAuthEnabled Boolean @default(true)
  /// When false, Gravatar requests are skipped and only initials are shown.
  gravatarsEnabled Boolean @default(true)
  /// Comma-separated IDs of module nav items shown in the header, in display order.
  navOrder         String  @default("events,polls")
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  authorId  String
  author    User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model ArticleReaction {
  articleId String
  userId    String
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([articleId, userId])
  @@index([articleId])
}

model Announcement {
  id         String    @id @default(cuid())
  message    String
  linkUrl    String?
  linkLabel  String?
  color      String    @default("brand")
  active     Boolean   @default(false)
  showFrom   DateTime?
  showUntil  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([active])
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  action       String
  resourceType String?
  resourceId   String?
  metadata     Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

enum PollStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum ResultsVisibility {
  ALWAYS
  AFTER_VOTE
  AFTER_CLOSE
  NEVER
}

model Poll {
  id                String            @id @default(cuid())
  question          String
  status            PollStatus        @default(DRAFT)
  anonymous         Boolean           @default(false)
  multiChoice       Boolean           @default(false)
  resultsVisibility ResultsVisibility @default(AFTER_VOTE)
  endsAt            DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  authorId          String
  author            User              @relation("PollAuthor", fields: [authorId], references: [id])
  options           PollOption[]
  votes             PollVote[]

  @@index([status, createdAt])
}

model PollOption {
  id     String     @id @default(cuid())
  pollId String
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text   String
  order  Int
  votes  PollVote[]
}

model PollVote {
  id        String     @id @default(cuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation("PollVoter", fields: [userId], references: [id])
  createdAt DateTime   @default(now())

  @@unique([pollId, userId, optionId])
  @@index([pollId])
}
