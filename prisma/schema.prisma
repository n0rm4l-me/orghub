generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  avatarUrl      String?
  /// bcrypt hash. Null for accounts that sign in only through an identity provider.
  passwordHash   String?
  role           Role      @default(VIEWER)
  department     String?
  externalId     String?
  provider       String?   @default("local")
  active         Boolean   @default(true)
  organizationId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  articles  Article[]
  auditLogs AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Article {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  body           Json
  excerpt        String?
  coverImage     String?
  published      Boolean   @default(false)
  publishedAt    DateTime?
  organizationId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  eventDate     DateTime?
  eventEndDate  DateTime?
  eventLocation String?
  pinned        Boolean   @default(false)

  authorId   String
  author     User                   @relation(fields: [authorId], references: [id])
  categories CategoriesOnArticles[]

  @@index([published, publishedAt])
  @@index([published, eventDate])
  @@index([organizationId])
}

model Page {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  body           Json
  published      Boolean  @default(false)
  /// Published pages are linked from the main menu unless this is turned off.
  showInNav      Boolean  @default(true)
  order          Int      @default(0)
  organizationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([published, order])
}

/// Sidebar shortcuts on the feed: payroll, VPN, service desk, and the like.
model QuickLink {
  id        String   @id @default(cuid())
  label     String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([order])
}

model Category {
  id       String                 @id @default(cuid())
  name     String
  slug     String                 @unique
  articles CategoriesOnArticles[]
}

model CategoriesOnArticles {
  articleId  String
  categoryId String
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([articleId, categoryId])
}

model Media {
  id           String   @id @default(cuid())
  filename     String
  url          String
  mimeType     String
  size         Int
  uploadedById String
  createdAt    DateTime @default(now())
}

model SiteSettings {
  id       String  @id @default("singleton")
  siteName String  @default("OrgHub")
  /// Logo for the brand-coloured header and the admin rail. Usually a white or
  /// knocked-out asset, which is why it must not be reused on white surfaces.
  logoUrl  String?
  /// Logo for white surfaces: the sign-in screen. Optional; when it is absent the
  /// lettermark is used, because falling back to `logoUrl` tends to render a white
  /// logo on a white card.
  logoOnLightUrl String?
  primaryColor   String @default("#2563eb")
  /// Comma-separated IDs of the feed sidebar blocks in display order.
  sidebarOrder   String @default("quickLinks,browseByTopic,upcomingEvents")
  /// Comma-separated IDs of enabled optional modules (e.g. "events").
  enabledModules String @default("events")
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  action       String
  resourceType String?
  resourceId   String?
  metadata     Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
